{
  "name": "usls-gs-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:ui": "node scripts/check-ui.mjs",
    "check:ui:strict": "node scripts/check-ui.mjs --strict",
    "test:check-ui": "node --test scripts/check-ui.test.mjs",
    "e2e": "npm run check:ui && node scripts/e2e.mjs --build",
    "e2e:negative": "vite build && node scripts/e2e.mjs --negative",
    "e2e:install": "node scripts/e2e.mjs install chromium"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
