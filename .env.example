# Copy this file to .env and put your real Gemini / Google AI Studio key there.
# Any one of these names is accepted by the Flask backend.
GOOGLE_API_KEY=
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional RAG settings.
GEMINI_MODEL=gemini-2.5-flash
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
