# Copy this file to a file named .env (or run `npm run setup:env`, add `-- --uat` for UAT) and fill in.
# The .env file itself is never committed.
#
# Lines starting with "NAME=" and nothing after the = are secrets/paths that mean "not set" when empty.
# Lines starting with "# NAME=value" show the built-in default: remove the "# " only to change the value.
# (An EMPTY numeric setting also means "not set"; the built-in default is used.)


# --- Core ---------------------------------------------------------------------------------
# sqlite:/// file path only (anything else is refused). Default: usls_gs_demo.sqlite3 in the repo folder.
DATABASE_URL=
# Address and port the app listens on. Keep 127.0.0.1 so only the tunnel/this PC can reach it.
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# 1 = presenter conveniences ON (demo-accounts panel, demo endpoints, shared password shown). 0 = off. Default 1.
# DEMO_MODE=1
# 1 = the public sign-in page lists the demo logins and the shared password (needs DEMO_MODE=1). Default 1.
# Set 0 on a public site such as UAT: the list disappears, the staff "Reset demo case" button stays.
# DEMO_SHOW_ACCOUNTS=1
# Panel-matching demo availability in the seed: 1 = on, 0 = off. Default 1 (the seed always forces it on).
# PANEL_MATCHING_DEMO_SEED=1
# Show invented sample calendar blocks in the faculty calendar: 1 = on. Default off.
DEMO_SAMPLE_CALENDAR=
# Domain used for generated student e-mail addresses. Default student.usls.edu.ph.
# STUDENT_EMAIL_DOMAIN=student.usls.edu.ph
# Folder for uploaded files. Default: a throwaway temp folder - set it to keep uploads between restarts.
USLS_UPLOAD_DIR=
# Folder for uploaded policy documents. Default: inside the uploads folder.
POLICY_DOCUMENT_UPLOAD_DIR=
# Biggest request body in MB the app accepts; larger uploads get a clean "too large" error. Default 30.
# MAX_UPLOAD_MB=30
# Biggest policy document upload in MB. Default 20.
# POLICY_DOCUMENT_MAX_MB=20
# 1 = do not build the demo database when the database file is empty (maintenance scripts). Default off.
USLS_SKIP_STARTUP_TASKS=
# How often (seconds) student risk levels are recomputed. Default 60.
# USLS_RISK_REFRESH_SECONDS=60

# --- UAT server (scripts/serve_uat.py, `npm run uat`) -------------------------------------
# Worker threads for the waitress server. Default 8.
# UAT_THREADS=8
# Biggest request body in MB the server accepts. Default 64.
# UAT_MAX_BODY_MB=64

# --- Security -----------------------------------------------------------------------------
# Signs the session cookie. Set a long random value for anything shared (sessions then survive restarts).
# If empty with DEMO_MODE on, a random key is created once in instance/secret_key; with DEMO_MODE off, a new key every start.
SECRET_KEY=
# Where that generated key is kept. Default instance/secret_key.
SECRET_KEY_FILE=
# 1 when the site is served over https (UAT through the tunnel). Default 0.
SESSION_COOKIE_SECURE=

# --- Sign-in limits (in memory, reset on restart) -----------------------------------------
# Failed sign-ins per e-mail before the wait starts. Default 5.
# LOGIN_MAX_FAILURES=5
# Failed sign-ins per visitor address before it is blocked. Default 40.
# LOGIN_IP_MAX_FAILURES=40
# Seconds the failures are remembered. Default 900.
# LOGIN_FAILURE_WINDOW_SECONDS=900
# First wait in seconds after too many failures (grows each time). Default 2.
# LOGIN_BASE_DELAY_SECONDS=2
# Longest single wait in seconds. Default 30.
# LOGIN_LOCKOUT_SECONDS=30

# --- Gemini policy assistant (optional; without a key the assistant uses local keyword search) ---
# Key from https://aistudio.google.com/apikey (GOOGLE_AI_STUDIO_API_KEY works too). Keep it secret.
GOOGLE_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
# Answer model. Default gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-latest
# Embedding model for document search. Default gemini-embedding-2.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Longest question the assistant accepts, in characters. Default 1500.
# ASSISTANT_MAX_QUESTION_LENGTH=1500
# Questions one account may ask the Policy Assistant per hour (a 429 message after that). Default 30.
# ASSISTANT_MAX_PER_HOUR=30

# --- Google Calendar (optional; faculty availability and defense events) ------------------
# OAuth 2.0 "Web application" client from the Google Cloud console.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must match an authorized redirect URI exactly, e.g. https://miguisanson.dev/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Fernet key that encrypts stored tokens. Generate once and keep it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Default Asia/Manila.
# GOOGLE_CALENDAR_TIMEZONE=Asia/Manila

# --- Document search (RAG) tuning ---------------------------------------------------------
# 1 = build the document index at start-up, 0 = skip. Default 1.
# RAG_PREWARM=1
# 1 = keep embedding documents in the background, 0 = off. Default 1.
# RAG_BACKGROUND_EMBED=1
# Where the search index is stored. Default .rag_index in the repo folder.
# RAG_INDEX_DIR=.rag_index
# Extra folders of documents to index (separated by ; on Windows).
RAG_DOCUMENT_DIRS=
# Chunk size and overlap in words. Defaults 180 / 30.
# RAG_CHUNK_SIZE=180
# RAG_CHUNK_OVERLAP=30
# How many passages go into an answer. Default 3.
# RAG_TOP_K=3
# Minimum similarity (0-1) for a passage to count. Default 0.60.
# RAG_MIN_SIMILARITY=0.60
# Embedding size, batch size, request timeout (seconds), cooldown after a failure (seconds). Defaults 768 / 20 / 45 / 60.
# RAG_EMBEDDING_DIMENSIONS=768
# RAG_EMBEDDING_BATCH_SIZE=20
# RAG_EMBEDDING_TIMEOUT_SECONDS=45
# RAG_EMBED_COOLDOWN_SECONDS=60
# Embedding done while a question is being answered: max chunks and timeout (seconds). Defaults 40 / 12.
# RAG_INLINE_EMBED_LIMIT=40
# RAG_INLINE_EMBED_TIMEOUT_SECONDS=12
# Answer generation: timeout (seconds), max output tokens, thinking budget. Defaults 18 / 1024 / 0.
# RAG_REQUEST_TIMEOUT_SECONDS=18
# RAG_MAX_OUTPUT_TOKENS=1024
# RAG_THINKING_BUDGET=0
# How many answers are cached. Default 128.
# RAG_RESPONSE_CACHE_SIZE=128
# Longest answer (characters) from local search without Gemini. Default 900.
# LOCAL_RAG_MAX_ANSWER_CHARS=900

# --- OCR for scanned PDFs (optional) ------------------------------------------------------
# Full path to tesseract.exe if it is not on PATH.
TESSERACT_CMD=
# Pages / resolution / minimum words before OCR kicks in. Defaults 8 / 200 / 30.
# PDF_OCR_MAX_PAGES=8
# PDF_OCR_DPI=200
# PDF_OCR_MIN_WORDS=30
# Most pages OCR'd per policy document. Default 40.
# POLICY_OCR_MAX_PAGES=40
